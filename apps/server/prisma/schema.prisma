generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  RESIDENT
  SOCIETY_ADMIN
  SHOP_OWNER
  SERVICE_PROVIDER
  GOVERNMENT_AUTHORITY
  SUPER_ADMIN
}

enum PostType {
  TEXT
  PHOTO
  VIDEO
  ANNOUNCEMENT
  EVENT
  QUESTION
  POLL
  LOST_AND_FOUND
  EMERGENCY_ALERT
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
  RESCHEDULED
  COMPLETED
  CANCELLED
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
}

enum ListingStatus {
  ACTIVE
  SOLD
  EXPIRED
  REMOVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  SYSTEM
}

enum NotificationType {
  PUSH
  EMAIL
  SMS
}

model User {
  id               String    @id @default(cuid())
  firebaseUid      String    @unique
  email            String    @unique
  phone            String?
  name             String
  avatar           String?
  role             UserRole  @default(RESIDENT)
  isVerified       Boolean   @default(false)
  isActive         Boolean   @default(true)
  emailVerified    Boolean   @default(false)
  phoneVerified    Boolean   @default(false)
  twoFactorEnabled Boolean   @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  profile                Profile?
  privacySettings        PrivacySettings?
  posts                  Post[]
  comments               Comment[]
  likes                  Like[]
  bookmarks              Bookmark[]
  sessions               Session[]
  businesses             Business[]
  serviceProviderProfile ServiceProvider?
  reviews                Review[]
  sentMessages           Message[]
  conversations          ConversationMember[]
  notifications          Notification[]
  complaints             Complaint[]
  listings               Listing[]
  events                 Event[]
  payments               Payment[]
  auditLogs              AuditLog[]
  adminOfSociety         Society[]            @relation("SocietyAdmin")
  visitorRecords         Visitor[]
  Notice                 Notice[]
  MaintenanceBill        MaintenanceBill[]
  EventRSVP              EventRSVP[]
  GovernmentNotice       GovernmentNotice[]
  CivicIssue             CivicIssue[]
  Subscription           Subscription[]
  Report                 Report[]
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  bio               String?
  dateOfBirth       DateTime?
  gender            String?
  address           String?
  city              String?
  state             String?
  country           String?
  zipCode           String?
  latitude          Float?
  longitude         Float?
  societyId         String?
  interests         String[]
  languages         String[]
  emergencyContacts Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  society Society? @relation(fields: [societyId], references: [id])
}

model PrivacySettings {
  id                  String   @id @default(cuid())
  userId              String   @unique
  hidePhone           Boolean  @default(false)
  hideEmail           Boolean  @default(false)
  hideAddress         Boolean  @default(false)
  hideOnlineStatus    Boolean  @default(false)
  hideLastSeen        Boolean  @default(false)
  allowMessages       Boolean  @default(true)
  allowFriendRequests Boolean  @default(true)
  profileVisibility   String   @default("PUBLIC")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  deviceName   String?
  deviceType   String?
  ipAddress    String?
  userAgent    String?
  token        String
  refreshToken String
  isActive     Boolean   @default(true)
  lastActiveAt DateTime  @default(now())
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Post {
  id            String   @id @default(cuid())
  authorId      String
  type          PostType
  title         String?
  content       String
  media         String[]
  pollOptions   Json?
  eventDate     DateTime?
  eventLocation String?
  tags          String[]
  societyId     String?
  isPublic      Boolean  @default(true)
  isPinned      Boolean  @default(false)
  isArchived    Boolean  @default(false)
  likesCount    Int      @default(0)
  commentsCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  society  Society?   @relation(fields: [societyId], references: [id])
  comments Comment[]
  likes    Like[]
  bookmarks Bookmark[]
  reports  Report[]
}

model Comment {
  id         String   @id @default(cuid())
  postId     String
  authorId   String
  parentId   String?
  content    String
  likesCount Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  post     Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("ThreadReplies", fields: [parentId], references: [id])
  replies  Comment[] @relation("ThreadReplies")
  likes    Like[]
  reports  Report[]
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Report {
  id          String   @id @default(cuid())
  reporterId  String
  postId      String?
  commentId   String?
  businessId  String?
  reason      String
  description String?
  status      String   @default("OPEN")
  reviewedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reporter User     @relation(fields: [reporterId], references: [id])
  post     Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment  Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Society {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  address     String
  city        String
  state       String
  country     String
  zipCode     String
  latitude    Float?
  longitude   Float?
  logo        String?
  banner      String?
  description String?
  totalUnits  Int?
  adminId     String
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  admin           User              @relation("SocietyAdmin", fields: [adminId], references: [id])
  members         Profile[]
  posts           Post[]
  notices         Notice[]
  complaints      Complaint[]
  visitors        Visitor[]
  amenities       Amenity[]
  maintenanceBills MaintenanceBill[]
  documents       SocietyDocument[]
  events          Event[]
}

model Notice {
  id        String   @id @default(cuid())
  societyId String
  authorId  String
  title     String
  content   String
  priority  String   @default("LOW")
  isPinned  Boolean  @default(false)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id])
}

model Visitor {
  id            String    @id @default(cuid())
  societyId     String
  residentId    String
  visitorName   String
  visitorPhone  String
  purpose       String
  vehicleNumber String?
  qrCode        String?
  checkInAt     DateTime?
  checkOutAt    DateTime?
  isApproved    Boolean   @default(false)
  approvedBy    String?
  createdAt     DateTime  @default(now())

  society  Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  resident User    @relation(fields: [residentId], references: [id])
}

model SocietyDocument {
  id         String   @id @default(cuid())
  societyId  String
  title      String
  fileUrl    String
  fileType   String
  uploadedBy String
  createdAt  DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
}

model Amenity {
  id              String   @id @default(cuid())
  societyId       String
  name            String
  description     String?
  bookingRequired Boolean  @default(false)
  availableFrom   String?
  availableTo     String?
  maxCapacity     Int?
  createdAt       DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
}

model MaintenanceBill {
  id         String   @id @default(cuid())
  societyId  String
  userId     String
  amount     Decimal
  dueDate    DateTime
  paidDate   DateTime?
  status     String
  invoiceUrl String?
  paymentId  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model Business {
  id                 String             @id @default(cuid())
  ownerId            String
  name               String
  slug               String             @unique
  description        String?
  category           String
  subcategory        String?
  phone              String
  email              String?
  website            String?
  address            String
  city               String
  state              String
  country            String
  zipCode            String
  latitude           Float?
  longitude          Float?
  logo               String?
  banner             String?
  photos             String[]
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  avgRating          Float              @default(0)
  totalReviews       Int                @default(0)
  isActive           Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  hours        BusinessHours[]
  menuItems    MenuItem[]
  services     ServiceItem[]
  reviews      Review[]
  appointments Appointment[]
  Report       Report[]
}

model BusinessHours {
  id         String  @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String
  closeTime  String
  isClosed   Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model MenuItem {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal
  image       String?
  category    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ServiceItem {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Decimal
  duration    Int
  image       String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model Review {
  id                String   @id @default(cuid())
  businessId        String?
  serviceProviderId String?
  userId            String
  rating            Int
  title             String?
  content           String?
  photos            String[]
  isVerified        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business        Business?        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceProvider ServiceProvider? @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Appointment {
  id         String            @id @default(cuid())
  businessId String
  serviceId  String?
  userId     String
  date       DateTime
  startTime  String
  endTime    String
  status     AppointmentStatus @default(PENDING)
  notes      String?
  totalPrice Decimal?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

model ServiceProvider {
  id                 String             @id @default(cuid())
  userId             String             @unique
  category           String
  title              String
  description        String?
  experience         Int
  priceRange         String?
  portfolio          String[]
  isVerified         Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  avgRating          Float              @default(0)
  totalReviews       Int                @default(0)
  locationRadius     Int
  isAvailable        Boolean            @default(true)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings ServiceBooking[]
  reviews  Review[]
}

model ServiceBooking {
  id                 String   @id @default(cuid())
  serviceProviderId  String
  userId             String
  serviceDescription String
  scheduledDate      DateTime
  scheduledTime      String
  duration           Int?
  address            String?
  status             String
  totalPrice         Decimal?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  serviceProvider ServiceProvider @relation(fields: [serviceProviderId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String   @id @default(cuid())
  name      String?
  type      String   @default("PRIVATE")
  avatar    String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String   @default("MEMBER")
  joinedAt       DateTime @default(now())
  lastReadAt     DateTime @default(now())
  isMuted        Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  content        String?
  fileUrl        String?
  fileName       String?
  fileSize       Int?
  replyToId      String?
  isEdited       Boolean     @default(false)
  isDeleted      Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])
  replyTo      Message?     @relation("ReplyTo", fields: [replyToId], references: [id])
  replies      Message[]    @relation("ReplyTo")
}

model Listing {
  id          String        @id @default(cuid())
  sellerId    String
  title       String
  description String
  price       Decimal
  category    String
  subcategory String?
  condition   String
  photos      String[]
  location    String?
  status      ListingStatus @default(ACTIVE)
  viewsCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  organizerId String
  societyId   String?
  title       String
  description String
  location    String
  latitude    Float?
  longitude   Float?
  startDate   DateTime
  endDate     DateTime
  coverImage  String?
  category    String
  maxAttendees Int?
  ticketPrice Decimal?
  isFree      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer User        @relation(fields: [organizerId], references: [id])
  society   Society?    @relation(fields: [societyId], references: [id])
  rsvps     EventRSVP[]
}

model EventRSVP {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  status    String   @default("GOING")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GovernmentNotice {
  id            String   @id @default(cuid())
  authorId      String
  title         String
  content       String
  category      String
  severity      String
  area          String?
  city          String?
  state         String?
  attachments   String[]
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  author User @relation(fields: [authorId], references: [id])
}

model CivicIssue {
  id          String          @id @default(cuid())
  reporterId  String
  title       String
  description String
  category    String
  photos      String[]
  latitude    Float?
  longitude   Float?
  address     String?
  status      ComplaintStatus @default(OPEN)
  assignedTo  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  reporter User @relation(fields: [reporterId], references: [id])
}

model Complaint {
  id          String          @id @default(cuid())
  societyId   String
  userId      String
  title       String
  description String
  category    String
  photos      String[]
  status      ComplaintStatus @default(OPEN)
  assignedTo  String?
  priority    String          @default("LOW")
  resolution  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])
}

model Payment {
  id                 String        @id @default(cuid())
  userId             String
  amount             Decimal
  currency           String        @default("USD")
  status             PaymentStatus @default(PENDING)
  provider           String
  providerPaymentId  String?
  type               String
  referenceId        String?
  metadata           Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Subscription {
  id                     String   @id @default(cuid())
  userId                 String
  plan                   String
  status                 String
  amount                 Decimal
  currency               String   @default("USD")
  interval               String
  providerSubscriptionId String?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelledAt            DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  body      String
  type      NotificationType @default(PUSH)
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
